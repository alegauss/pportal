<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PP44's gate. Not in a solution: PP24 has not made one yet. Unlike spike/present-path this is
    meant to persist - it is the assertion PP27's transport has to keep passing - and it is a plain
    console app returning a non-zero exit code rather than a test-framework project, so PP36 can
    put it in CI without first deciding on a runner.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>alloc-budget</AssemblyName>
    <RootNamespace>AllocBudget</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Server GC would change when collections happen and hide a per-packet allocation behind a
         larger budget. The gate measures bytes allocated, not collections, but the default is
         pinned anyway so two runs on two machines mean the same thing. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
