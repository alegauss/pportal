<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PP52's reading, as a spike rather than an argument. Like the others it is deliberately not in
    any solution: it exists to produce a number and the conditions it was taken under, re-runnable
    by whoever doubts it.

    PP52's section proposes NVIDIA's audio effects SDK for echo cancellation and noise removal, and
    calls it "the first card in this port's audio". PP647's hardware contract binds any vendor path
    to an absence that is quiet, and PP648 established that a call which succeeds is not a feature
    that ran. Neither of those is the first question. The first question is whether the vendor path
    is REACHABLE on a machine with the card - and, if it is not, what the machine has instead.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>audio-effects</AssemblyName>
    <RootNamespace>AudioEffects</RootNamespace>
  </PropertyGroup>

</Project>
