<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PP652's reading, as a spike rather than an argument. Like the others it is deliberately not in
    any solution: it exists to produce a number and the conditions it was taken under, re-runnable
    by whoever doubts it.

    MicrophoneSurface established that four subsystems assume a microphone and nothing opens a
    device, and named five candidate APIs without choosing. streamconnection.c announces the
    microphone as one channel, sixteen bits, 48000 Hz and 480 frames. This asks the machine what its
    own capture devices offer, and whether that announced format is taken directly - because a yes
    means no conversion stage and no new dependency, and a no means both are owed.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>mic-capture</AssemblyName>
    <RootNamespace>MicCapture</RootNamespace>
  </PropertyGroup>

</Project>
