<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A spike, deliberately not in any solution: the tree has no .NET solution yet (PP24), and
    this project must not become the thing PP1 is supposed to build. It exists to produce two
    numbers and the conditions they were taken under, and to still be re-runnable by whoever
    doubts them.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>present-path</AssemblyName>
    <RootNamespace>PresentPath</RootNamespace>
    <!-- A console is attached so the run reports to stdout as well as to its JSON. -->
    <DisableWinExeOutputInference>true</DisableWinExeOutputInference>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Hand-rolled IDirect3DDevice9Ex vtables were the alternative. A transposed slot there does
      not fail loudly, it returns a plausible number - which is the one outcome a measurement
      spike cannot tolerate. A maintained binding is the cheaper correctness.
    -->
    <PackageReference Include="Vortice.Direct3D9" Version="3.6.2" />
  </ItemGroup>

</Project>
