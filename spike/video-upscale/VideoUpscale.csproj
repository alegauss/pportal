<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PP47's evaluation, as a spike rather than an argument. Like present-path it is deliberately
    not in any solution: the tree has no .NET solution yet (PP24), and this exists to produce a
    number and the conditions it was taken under, re-runnable by whoever doubts it.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- For PngBitmapEncoder alone. There is no window here: the video processor writes to a
         texture and the texture is read back, so nothing is presented and nothing is composed. -->
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>video-upscale</AssemblyName>
    <RootNamespace>VideoUpscale</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Same reasoning present-path recorded: a hand-rolled ID3D11VideoContext vtable does not fail
      loudly when a slot is transposed, it returns a plausible number, and that is the one outcome
      a measurement spike cannot tolerate. VideoProcessorSetStreamExtension sits at a slot this
      binding already knows.
    -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Linked, not copied. The percentile convention is the thing being reused - a second copy that
      drifts would make two spikes' numbers quietly incomparable, which is the failure PP45 is
      about one level up. It keeps its PresentPath namespace because moving it would be a change
      to a shipped spike for this one's convenience.
    -->
    <Compile Include="../present-path/Stats.cs" Link="Stats.cs" />
  </ItemGroup>

</Project>
