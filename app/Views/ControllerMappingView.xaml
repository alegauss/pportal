<UserControl x:Class="ChiakiNg.Views.ControllerMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    PP18: the controller mapping screen.

    What this markup CANNOT show is the half the task is about: the screen lights up whatever the
    user presses, and there is no pad here. Everything drawn below is the grid and the capture
    modal; the sequence a press drives is the view model's, and is asserted without a device.

    A row is one button wide or two. The second slot is bound to its own visibility because a
    chiaki button may have one physical binding or two, and a slot drawn over nothing captures into
    nothing.
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="16">
        <TextBlock x:Name="Title" FontSize="20" Text="{Binding Title}" />

        <CheckBox x:Name="AnalogBox" Margin="0,12,0,0"
                  Content="Allow mapping analog sticks and L2/R2"
                  IsChecked="{Binding EnableAnalogStickMapping}" />

        <ItemsControl x:Name="RowsList" ItemsSource="{Binding Rows}" Margin="0,16,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{Binding Name}" Width="160" TextAlignment="Right"
                           VerticalAlignment="Center" Margin="0,0,10,0" />

                <!-- PP223: Tag carries the SLOT, because a row's two buttons are the same button
                     twice and only their position tells them apart. The row itself comes from the
                     DataContext and its index from the collection, so nothing here has to know
                     where in the list it sits. -->
                <!-- PP619: the slot says which slot it is, to a check and to a screen reader.
                     The id is built from Value, the chiaki button, because that is the row's stable
                     key - Name is its label and would move with a translation, and the position in
                     the list moves whenever a row is added. Nothing outside this window could
                     address one before: PP227's harness took every Button and kept the ones whose
                     AutomationId was EMPTY, which held only while every other button on the screen
                     kept an id and broke silently the first time one did not.

                     HelpText and not Name, so the binding a person sees is still what a reader
                     hears: the content is the physical button bound here, and a Name set on top of
                     it would replace the value with the label. This adds the context that was
                     missing rather than trading one for the other. -->
                <Button Content="{Binding First}" Tag="0"
                        AutomationProperties.AutomationId="{Binding Value, StringFormat=slot.{0}.0}"
                        AutomationProperties.HelpText="{Binding Name, StringFormat='{}{0}, first slot'}"
                        Width="140" Height="52" Margin="0,0,10,0" />

                <Button Content="{Binding Second}" Tag="1" Width="140" Height="52"
                        AutomationProperties.AutomationId="{Binding Value, StringFormat=slot.{0}.1}"
                        AutomationProperties.HelpText="{Binding Name, StringFormat='{}{0}, second slot'}"
                        Visibility="{Binding HasSecond, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button x:Name="UpdateButton" Content="Update Controller Mapping"
                HorizontalAlignment="Right" Margin="0,16,0,0" Padding="20,4"
                IsEnabled="{Binding CanApply}" />
      </StackPanel>
    </ScrollViewer>

    <!-- The capture modal. Its prompt carries the pad's own name in the middle of the sentence,
         which is the one string on this screen that changes with the device. -->
    <Grid x:Name="CaptureOverlay" Background="#C0000000"
          Visibility="{Binding CaptureOpen, Converter={StaticResource BoolToVisibility}}">
      <Border Background="#202020" BorderBrush="#40808080" BorderThickness="1"
              Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel Margin="16">
          <TextBlock FontSize="18" Text="Button Capture" />
          <TextBlock x:Name="CapturePrompt" Margin="0,12,0,0" TextWrapping="Wrap"
                     Text="{Binding CapturePrompt}" />
          <Button x:Name="CaptureCloseButton" Content="Close" HorizontalAlignment="Right"
                  Margin="0,12,0,0" Padding="20,4" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
