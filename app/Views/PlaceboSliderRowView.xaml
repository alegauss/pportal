<UserControl x:Class="ChiakiNg.Views.PlaceboSliderRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    PP17: one row of either placebo screen, written once.

    The two screens have forty of these between them and they differ in four numbers, a label and a
    condition - all of which are the view model's. The QML writes each one out and repeats its
    condition on three elements; this is the same row bound once, which is what makes the tables
    from PP168 and PP170 the single place a bound can be wrong.
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
              Visibility="{Binding Visible, Converter={StaticResource BoolToVisibility}}">
    <TextBlock x:Name="RowLabel" Text="{Binding Label}" Width="200" TextAlignment="Right"
               VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" />

    <Slider x:Name="RowSlider" Width="250" VerticalAlignment="Center"
            Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
            SmallChange="{Binding Step}" Value="{Binding Value}" />

    <TextBlock x:Name="RowCaption" Text="{Binding Caption}" Margin="10,0,0,0"
               VerticalAlignment="Center" MinWidth="70" />
  </StackPanel>
</UserControl>
