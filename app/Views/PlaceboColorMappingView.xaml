<UserControl x:Class="ChiakiNg.Views.PlaceboColorMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ChiakiNg.Views">
  <!--
    PP17: the Color Mapping Settings screen.

    Two function combos and twenty-two rows, and the rows are an ItemsControl over the table rather
    than twenty-two blocks of markup. That is not a shortcut: the QML repeats each row's condition
    on its label, its slider and its hint, and the whole finding of PP168 was what those repetitions
    hide - so a port that repeated them again would be reproducing the mistake rather than the
    screen.

    The combos are filled in code-behind from the same StoredChoice tables the store reads, so the
    order on screen and the word in the file cannot drift apart.
  -->
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <TextBlock Text="* Defaults in () to right of value or marked with (Default)"
                 Opacity="0.7" Margin="0,0,0,12" />

      <TextBlock Text="Gamut Mapping Function:" Margin="0,8,0,2" Opacity="0.7" />
      <ComboBox x:Name="GamutCombo" Width="400" HorizontalAlignment="Left"
                SelectedIndex="{Binding GamutFunction}" />

      <ItemsControl x:Name="GamutRows" ItemsSource="{Binding Gamut}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <views:PlaceboSliderRowView />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <CheckBox x:Name="TricubicBox" Margin="0,12,0,0"
                Content="LUT 3D Tricubic Enabled:" IsChecked="{Binding Lut3dTricubic}" />
      <CheckBox x:Name="GamutExpansionBox" Margin="0,4,0,0"
                Content="Gamut Expansion Enabled:" IsChecked="{Binding GamutExpansion}" />

      <TextBlock Text="Tone-mapping Function:" Margin="0,16,0,2" Opacity="0.7" />
      <ComboBox x:Name="ToneCombo" Width="400" HorizontalAlignment="Left"
                SelectedIndex="{Binding ToneFunction}" />

      <ItemsControl x:Name="ToneRows" ItemsSource="{Binding Tone}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <views:PlaceboSliderRowView />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <CheckBox x:Name="InverseBox" Margin="0,12,0,0"
                Content="Inverse Tone-mapping Enabled:" IsChecked="{Binding InverseToneMapping}" />

      <TextBlock Text="Tone-mapping Metadata:" Margin="0,12,0,2" Opacity="0.7" />
      <ComboBox x:Name="MetadataCombo" Width="400" HorizontalAlignment="Left"
                SelectedIndex="{Binding ToneMetadata}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
