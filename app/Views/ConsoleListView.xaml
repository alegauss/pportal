<UserControl x:Class="ChiakiNg.Views.ConsoleListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:session="clr-namespace:ChiakiNg.Session">
  <!--
    PP13: the front door, and the first screen with a view model behind it.

    Thin on purpose. Every rule about what is on this list and what is shown lives in
    ConsoleList (PP138) and is asserted without a window; what is here is the arrangement, and
    the arrangement is the part a test could only photograph.

    Two bindings carry decisions rather than layout, and both are noted where they are made.
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!--
      One row. Display is bound to Visibility rather than used to filter the list, because the
      model KEEPS rows it does not show - PP138 - and filtering here would renumber every index
      the keyboard navigation walks.
    -->
    <DataTemplate x:Key="ConsoleRowTemplate" DataType="{x:Type session:ConsoleRow}">
      <Border Padding="12,8" Margin="0,2"
              Visibility="{Binding Display, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
          <DockPanel>
            <!--
              PP600: the action the list decided about and never performed. IsEnabled follows
              ConsoleRow.Connectable, which is ConsoleConnect.CanConnect - so the rule that a
              console must be paired and have an address is stated once, in code that is asserted,
              rather than as a pair of triggers here.
            -->
            <Button x:Name="ConnectButton" DockPanel.Dock="Right"
                    Content="Connect" Padding="12,2" Click="OnConnect"
                    IsEnabled="{Binding Connectable}" />
            <TextBlock Text="{Binding Name}" FontSize="16" />
          </DockPanel>
          <StackPanel Orientation="Horizontal" Opacity="0.6">
            <TextBlock Text="{Binding Address}" />

            <!-- "Registered" is the word the Qt client uses for paired, and a console that is
                 not registered cannot be connected to - so it is stated rather than implied by
                 a disabled button nobody can explain. -->
            <TextBlock Text="  ·  not registered" Margin="8,0,0,0">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Visibility" Value="Visible" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Registered}" Value="True">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <ItemsControl x:Name="Rows" Grid.Row="0"
                  ItemsSource="{Binding Rows}"
                  ItemTemplate="{StaticResource ConsoleRowTemplate}" />

    <!--
      PP600: what the last connect attempt said, WHERE THE PERSON IS LOOKING - PP224's rule, which
      was filed because a failure written to standard error reached nobody. Every refusal this
      screen can produce is about the room rather than about the code, so all of them belong here.
    -->
    <DockPanel Grid.Row="1" Margin="12,4">
      <!--
        PP625: the way out. A session outlives the click now, so without this the console stays
        occupied until the process does and the person who clicked Connect has no answer except
        closing the window. Enabled only while there is one, which is HasSession.
      -->
      <Button x:Name="DisconnectButton" DockPanel.Dock="Right"
              Content="Disconnect" Padding="12,2" Click="OnDisconnect"
              IsEnabled="{Binding HasSession}" />
      <TextBlock x:Name="ConnectStatus"
                 Text="{Binding Status}" VerticalAlignment="Center"
                 TextWrapping="Wrap" Opacity="0.8" />
    </DockPanel>

    <!--
      The empty state, which is a real state and not an oversight: discovery answering nothing is
      the ordinary case on a network with the console asleep, and a blank panel reads as broken.
    -->
    <TextBlock x:Name="EmptyMessage"
               Text="No consoles found."
               HorizontalAlignment="Center" VerticalAlignment="Center"
               Opacity="0.5" FontSize="16">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding HasVisibleRows}" Value="False">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </Grid>
</UserControl>
