<UserControl x:Class="ChiakiNg.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:session="clr-namespace:ChiakiNg.Session">
  <!--
    PP14: profiles - one dialog doing three jobs, which is why the mode drives the markup and the
    markup drives nothing else.

    Two of the three jobs show a control the other two do not, and the third shows neither. That is
    the only thing this file decides; whether the button is enabled is CanAccept's answer in all
    three modes, including the one where selecting "default" against a current profile stored as
    the empty string is a no-op the button refuses.

    The combo binds SelectedItem and not the index, because here the value IS the answer - the
    view model compares the combo's spelling against the setting's, and an index cannot be
    compared to a profile name.
  -->
  <StackPanel Margin="16">
    <TextBlock Text="Profile" Margin="0,0,0,2" Opacity="0.7" />
    <ComboBox x:Name="ProfileCombo" SelectedItem="{Binding Selected}" />

    <StackPanel x:Name="NameGroup">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Mode}" Value="{x:Static session:ProfileDialogMode.Create}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>

      <TextBlock Text="New profile name" Margin="0,12,0,2" Opacity="0.7" />
      <TextBox x:Name="NameField" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>

    <!-- Deleting asks for nothing else, so the tick is the whole of the condition. -->
    <CheckBox x:Name="DeleteBox" Margin="0,12,0,0"
              Content="Delete this profile and everything in it"
              IsChecked="{Binding DeleteChecked}">
      <CheckBox.Style>
        <Style TargetType="CheckBox">
          <Setter Property="Visibility" Value="Collapsed" />
          <Style.Triggers>
            <DataTrigger Binding="{Binding Mode}" Value="{x:Static session:ProfileDialogMode.Delete}">
              <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </CheckBox.Style>
    </CheckBox>

    <Button x:Name="AcceptButton" Content="OK"
            HorizontalAlignment="Right" Margin="0,16,0,0" Padding="20,4"
            IsEnabled="{Binding CanAccept}" />
  </StackPanel>
</UserControl>
