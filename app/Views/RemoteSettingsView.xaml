<UserControl x:Class="ChiakiNg.Views.RemoteSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    PP16: the settings screen's Remote tab, the eighth of the nine.

    Two buttons in one place and never both at once - Login while any of the four PSN credentials
    is missing, Clear only when all four are there. Both visibilities are the view model's, and
    they are separate properties rather than one and its negation because the QML writes them as
    two independent expressions over the same four values.
  -->
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style TargetType="TextBlock" x:Key="RowLabel">
      <Setter Property="Margin" Value="0,10,8,2" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
  </UserControl.Resources>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <Button x:Name="LoginButton" Content="Login to PSN" HorizontalAlignment="Center"
              Padding="20,4"
              Visibility="{Binding LoginVisible, Converter={StaticResource BoolToVisibility}}" />

      <Button x:Name="ClearTokenButton" Content="Clear PSN Token" HorizontalAlignment="Center"
              Padding="30,26"
              Visibility="{Binding ClearVisible, Converter={StaticResource BoolToVisibility}}" />

      <TextBlock Text="Hole Punching Port Guessing:" Style="{StaticResource RowLabel}" />
      <StackPanel Orientation="Horizontal">
        <CheckBox x:Name="PortGuessingBox" Content="Force STUN port guessing"
                  IsChecked="{Binding PortGuessingEnabled}" />
        <TextBlock Text="(Unchecked)" Margin="20,0,0,0" Opacity="0.6" />
      </StackPanel>

      <TextBlock Text="Port Guess Count:" Style="{StaticResource RowLabel}" />
      <StackPanel Orientation="Horizontal">
        <Slider x:Name="CountSlider" Width="250" Minimum="0" Maximum="75" SmallChange="1"
                Value="{Binding PortGuessCount}" />
        <TextBlock x:Name="CountCaption" Margin="10,0,0,0" VerticalAlignment="Center"
                   Text="{Binding PortGuessCountCaption}" />
        <TextBlock Text="(75)" Margin="100,0,0,0" VerticalAlignment="Center" Opacity="0.6" />
      </StackPanel>

      <TextBlock Text="Port Guess Socket Count:" Style="{StaticResource RowLabel}" />
      <StackPanel Orientation="Horizontal">
        <Slider x:Name="SocketSlider" Width="250" Minimum="0" Maximum="500" SmallChange="1"
                Value="{Binding PortGuessSocketCount}" />
        <TextBlock x:Name="SocketCaption" Margin="10,0,0,0" VerticalAlignment="Center"
                   Text="{Binding PortGuessSocketCountCaption}" />
        <TextBlock Text="(250)" Margin="100,0,0,0" VerticalAlignment="Center" Opacity="0.6" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
