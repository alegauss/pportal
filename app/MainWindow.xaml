<Window x:Class="ChiakiNg.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="chiaki-ng"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen">
  <!-- Opens empty, as PP1 filed it: the size a 720p stream wants and the title an installer and a
       taskbar will show. What PP223 added is the ContentControl, and its emptiness is the point -
       PP37's note on this window asked that the first thing in here be a BINDING TO A VIEW MODEL
       rather than an event handler, and a content host is that with nothing assumed about which
       screen goes in it. The placeholder is what shows while nothing has. -->
  <Grid>
    <TextBlock x:Name="Placeholder" Text="chiaki-ng"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="24" Opacity="0.5" />

    <ContentControl x:Name="Screen" />
  </Grid>
</Window>
