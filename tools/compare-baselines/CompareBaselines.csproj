<Project Sdk="Microsoft.NET.Sdk">

  <!--
    PP45's harness. Not in a solution: PP24 has not made one. A plain console app so it can be run
    from a shell today and from CI later without first choosing a runner.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>compare-baselines</AssemblyName>
    <RootNamespace>CompareBaselines</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
